        "promote_to_ontology": true,
        "domain": "https://w3id.org/neoolaf/eventstoryline/Event",
        "range": "https://w3id.org/neoolaf/eventstoryline/Event",
        "definition": "A directed storyline relation linking an event to a subsequent/downstream consequence, continuation, aftermath, or narratively dependent event when PRECONDITION is not the better interpretation.",
        "synonyms": [
          "follow-up",
          "aftermath",
          "consequence",
          "continuation"
        ]
      }
    },
    "seed_ontology_role": "External OWL-Time grounding resource, matching the RAGTree EventStoryLine experiment.",
    "task_relation_schema": "examples/RAGTreeDatasets/ontology/eventstoryline_relation_catalog.json",
    "task_relation_schema_role": "Controlled benchmark relation IDs and definitions used for mapping and ontology evolution; not a replacement seed ontology."
  },
  "eventstoryline_type_constraints": {
    "PRECONDITION": {
      "source": [
        "EVENT"
      ],
      "target": [
        "EVENT"
      ]
    },
    "FALLING_ACTION": {
      "source": [
        "EVENT"
      ],
      "target": [
        "EVENT"
      ]
    }
  },
  "layer02_compact_candidate_cap": 2,
  "orchestration": {
    "retry_failed_calls": 1,
    "retry_sleep_seconds": 1.0
  },
  "benchmark_projection": {
    "enabled": true,
    "gold_available_to_pipeline": false,
    "stage": "analysis_after_layer12",
    "exact_span_first": true,
    "fallback_unique_trigger": true,
    "create_relations": false,
    "same_seed_ontology_as_ragtree": true,
    "layer01_closed_inventory": true,
    "source_token_span_repair": true,
