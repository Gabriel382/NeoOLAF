{
  "profile_name": "eventstoryline_native_event_relation_ablation_v1_3_owltime_recall",
  "description": "One-document EventStoryLine native NeoOLAF experiment using the same OWL-Time seed ontology as RAGTree, parallel sentence-level high-recall event extraction, two whole-document coverage-review passes, deterministic source-token span validation and bounded repair, closed-inventory source-batched PLOT_LINK generation, parallel two-class controlled relation linking in Layer 2, deterministic event endpoint resolution in Layer 4, full Layer 0-12 artifacts, and strict evaluation after execution.",
  "language": {
    "source": "en",
    "target": "en",
    "translate": false,
    "translate_in_preprocessing": false,
    "llm_translate_inside_extraction": false
  },
  "chunking": {
    "strategies": [
      "fixed"
    ],
    "preferred_unit_for_extraction": "chunk",
    "whole_document_preferred": true,
    "chunk_size": 18000,
    "overlap": 0,
    "max_safe_chunk_chars": 26000
  },
  "layers": {
    "layer01_linguistic_expression_extraction": {
      "strategy": "eventstoryline_parallel_sentence_inventory_plus_document_review_plus_source_batched_relations",
      "max_concurrency": 8,
      "rag_enabled": false,
      "max_output_tokens": 8192,
      "request_timeout_seconds": 180,
      "response_hard_cap_chars": 52000,
      "phase_count": 3,
      "structured_event_output": true,
      "closed_inventory_relation_generation": true,
      "deterministic_source_token_validation": true,
      "bounded_span_repair": true,
      "reject_connective_only_events": true,
      "complete_phrasal_verbs": true,
      "complete_hyphenated_triggers": true,
      "sentence_workers": 8,
      "coverage_review_passes": 2,
      "relation_workers": 8,
      "relation_source_batch_size": 4,
      "skip_url_and_date_metadata_sentences": true,
      "eventive_nominal_and_state_review": true,
      "preserve_repeated_mentions": true,
      "plot_link_broader_than_strict_causality": true
    },
    "layer02_candidate_enrichment": {
      "strategy": "eventstoryline_two_relation_contrastive",
      "max_concurrency": 16,
      "max_expressions": null,
      "use_web_search": false,
      "retry_failed_calls": 1,
      "max_output_tokens": 384,
      "request_timeout_seconds": 60,
      "response_hard_cap_chars": 5000,
      "deterministic_node_enrichment": true,
      "llm_relation_enrichment_only": true,
      "compact_candidate_cap": 2
    },
    "layer03_candidate_typing_resolution": {
      "strategy": "ontology_aware_role_based_typing",
      "max_concurrency": 1,
      "max_expressions": null,
      "inject_empty_relation_schema_candidates": false
    },
    "layer04_candidate_relation_extraction": {
      "strategy": "structured_exact_then_native_parallel_fallback",
      "max_concurrency": 8,
      "max_relation_mentions": null,
      "retry_failed_calls": 0,
      "max_attempts_per_relation": 1,
      "retry_wait_seconds": 0.5,
      "max_output_tokens": 384,
      "request_timeout_seconds": 60,
      "response_hard_cap_chars": 6000,
      "deterministic_exact_endpoint_resolution": true,
      "event_to_event_validation": true
    },
    "layer05_candidate_triple_generation": {
      "strategy": "ontology_aware_assertion_to_triples",
      "max_concurrency": 4
    },
    "layer06_concept_relation_induction": {
      "strategy": "ontology_aware_triple_concept_relation_induction",
      "max_concurrency": 4
    },
    "layer07_hierarchisation": {
      "strategy": "ontology_aware_parent_hint_hierarchy",
      "max_concurrency": 4
    },
    "layer08_axiom_schemata_extraction": {
      "strategy": "ontology_aware_axiom_schema_generation",
      "max_concurrency": 4
    },
    "layer09_general_axiom_extraction": {
      "strategy": "ontology_aware_schema_to_general_axioms",
      "max_concurrency": 4
    },
    "layer10_validation_reasoning": {
      "strategy": "ontology_aware_validation_reasoning",
      "max_concurrency": 4
    },
    "layer11_inference_completion": {
      "strategy": "ontology_aware_semantic_completion",
      "max_concurrency": 4
    },
    "layer12_serialization": {
      "max_concurrency": 4
    }
  },
  "relations": {
    "allowed": [],
    "canonical_identifier": "EventStoryLine relation label",
    "property_count": 2,
    "catalog_path": "examples/RAGTreeDatasets/ontology/eventstoryline_relation_catalog.json",
    "ontology_property_count": null,
    "priority_ids": [
      "PRECONDITION",
      "FALLING_ACTION"
    ],
    "allowed_inventory_location": "controlled task relation catalog + task guidance; OWL-Time is the external seed ontology and target relations may be induced as ontology deltas"
  },
  "rag": {
    "backend": "owl_time_seed_plus_controlled_eventstoryline_task_schema",
    "top_k": 4,
    "allowed_spaces": {
      "layer02_candidate_enrichment": [
        "ontology"
      ],
      "layer03_candidate_typing_resolution": [
        "ontology"
      ],
      "layer04_candidate_relation_extraction": [
        "ontology"
      ],
      "layer06_concept_relation_induction": [
        "ontology"
      ],
      "layer07_hierarchisation": [
        "ontology"
      ],
      "layer08_axiom_schemata_extraction": [
        "ontology"
      ]
    },
    "query_expansions": {
      "precondition": [
        "before",
        "temporal entity",
        "interval",
        "has beginning",
        "has end"
      ],
      "prerequisite": [
        "before",
        "temporal relation",
        "interval"
      ],
      "enable": [
        "before",
        "temporal entity",
        "interval"
      ],
      "require": [
        "before",
        "temporal entity"
      ],
      "falling action": [
        "after",
        "temporal entity",
        "interval"
      ],
      "follow": [
        "after",
